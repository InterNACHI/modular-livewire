{
  "name": "internachi/modular-livewire",
  "description": "Livewire plugin for internachi/modular",
  "keywords": [
    "laravel",
    "modules",
    "modular",
    "livewire"
  ],
  "authors": [
    {
      "name": "Chris Morrell",
      "homepage": "http://www.cmorrell.com"
    },
    {
        "name": "Kevin Ullyott",
        "homepage": "https://kevinullyott.com"
    }
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "illuminate/support": "^11|^12|^13",
    "internachi/modular": "^3.0",
    "livewire/livewire": "^3.0|^4.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.11|^10.0|^11.0",
    "friendsofphp/php-cs-fixer": "^3.34",
    "phpunit/phpunit": "^10.5|^11.5|^12.5|^13.0"
  },
  "autoload": {
    "psr-4": {
      "InterNACHI\\ModularLivewire\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "InterNACHI\\ModularLivewire\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "fix-style": "vendor/bin/php-cs-fixer fix",
    "check-style": "vendor/bin/php-cs-fixer fix --diff --dry-run"
  },
  "extra": {
    "laravel": {
      "providers": [
        "InterNACHI\\ModularLivewire\\Support\\ModularLivewireServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
